{
  "name": "malebolge",
  "version": "0.0.0",
  "private": true,
  "description": "Durable host for interactive SATAN, on pi-durable",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "malebolge": "./src/daemon-main.ts",
    "malebolge-attach": "./src/attach-main.ts",
    "satan-runner": "./src/runner-main.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/pi-env": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "smol-toml": "1.9.1",
    "typebox": "1.3.27",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-unicorn": "78.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
