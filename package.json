{
  "name": "malebolge",
  "version": "0.0.0",
  "private": true,
  "description": "Durable host for interactive SATAN, on pi-durable",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "malebolge": "./src/daemon-main.ts",
    "malebolge-attach": "./src/attach-main.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
